APP_NAME=WoofCircle
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://woofcircle.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB on cPanel / Shared Hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# Queue & Filesystem
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Mail Configuration (mail.woofcircle.in)
MAIL_MAILER=smtp
MAIL_HOST=mail.woofcircle.in
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@woofcircle.in
MAIL_PASSWORD="K@1973$2846#s"
MAIL_FROM_ADDRESS="no-reply@woofcircle.in"
MAIL_FROM_NAME="${APP_NAME}"

# Specific Department Mailboxes (Passwords default to MAIL_PASSWORD if not specified)
MAIL_SUPPORT_USERNAME=support@woofcircle.in
MAIL_INFO_USERNAME=info@woofcircle.in
MAIL_HELLO_USERNAME=hello@woofcircle.in

# Real-Time Broadcasting (Laravel Reverb)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=694676
REVERB_APP_KEY=unkokv4mxrpmltx2l6ht
REVERB_APP_SECRET=cfuuyjq5cnk2w6vndxk7
REVERB_HOST="woofcircle.in"
REVERB_PORT=8080
REVERB_SCHEME=https

# Vite Environment Variables (Frontend Client / Reverb Echo)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Push Notifications (OneSignal Web & Mobile Push)
ONESIGNAL_APP_ID=6d38b531-5245-432b-b902-b1171e1ce056
ONESIGNAL_REST_API_KEY=

